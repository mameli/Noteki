<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates. Takku lists as Editors the apps with the Editor
	     role for Markdown, and hands "Show all" to those that open folders. Not plain text: that
	     type covers every source file too. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- Updates with Sparkle (ADR 0011): the appcast of the latest GitHub Release, and the public
	     half of the EdDSA key that signs the disk images (account "noteki" in the keychain). -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/mameli/Noteki/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>yiDSZZuHxZyVOGgVD1WcUiTePxFrTHbyMjLr9iIW+CE=</string>
</dict>
</plist>
